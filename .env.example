# Local dev: leave BASE_PATH empty so the app serves at http://localhost:3000/
NEXT_PUBLIC_BASE_PATH=

# CI (GitHub Pages project site): set to the repo subpath, e.g. /wraythx
# NEXT_PUBLIC_BASE_PATH=/wraythx

# Canonical origin used for sitemap, robots, OG, and JSON-LD.
# Local: any placeholder works. CI: the Pages domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://thesandeepstudio.github.io
